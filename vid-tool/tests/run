#!/bin/bash
# Tests for vid-tool. Needs ffmpeg; the prompt tests also need expect.
#
#   vid-tool/tests/run
#
# Makes its own test clips with ffmpeg in a temp folder and deletes the
# folder on exit. Exits non-zero if any check fails. Runs vid-tool under
# /bin/bash, which on macOS is bash 3.2.
#
# The pickers use fzf when fzf is on PATH and standard input and error are
# terminals. This script hides fzf from the other checks, the prompt tests
# included, by setting ANDROID_TOOLS_NO_FZF=1 (the tool's documented switch).
# The fzf checks turn it back on and run the tool through tests/tty.exp (expect,
# which ships with macOS) so it has a terminal. They put a fake fzf
# (tests/fakes/fzf) first on PATH, so a real fzf on the machine is never used.
#
# A check that can't run prints a SKIP line saying why. On a Mac a skip is not
# a failure. When the CI variable is set, a skip makes the run fail.

here=$(cd "$(dirname "$0")" && pwd)
tool="$here/../vid-tool"
real=$(command -v ffmpeg) || {
  echo "ffmpeg not found on PATH. Install it with: brew bundle --file=vid-tool/tests/Brewfile" >&2
  exit 1
}

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
stub="$work/stub"
mkdir -p "$stub" "$work/empty"
cd "$work" || exit 1
# The tool reads its config from here, never from the real ~/.config.
export XDG_CONFIG_HOME="$work/config"
conf="$XDG_CONFIG_HOME/android-tools/vid-tool.conf"

fakes="$here/../../tests/fakes"
export ANDROID_TOOLS_NO_FZF=1 FAKE_FZF_LOG="$work/fzf.log" FAKE_STATE="$work"

# A fake ffmpeg that hides encoders matching $HIDE from 'ffmpeg -encoders',
# and passes everything else to the real one. Simulates a build without them.
cat > "$stub/ffmpeg" <<EOF
#!/bin/bash
real="$real"
for a in "\$@"; do
  if [[ \$a == -encoders ]]; then "\$real" "\$@" 2>/dev/null | grep -vE "\$HIDE"; exit 0; fi
done
exec "\$real" "\$@"
EOF
chmod +x "$stub/ffmpeg"

# --- Test clips -----------------------------------------------------------------
q() { ffmpeg -nostdin -hide_banner -loglevel error -y "$@"; }
q -f lavfi -i testsrc2=size=540x1200:rate=30 -f lavfi -i sine=frequency=440 -t 12 \
  -c:v libx264 -crf 12 -pix_fmt yuv420p -c:a aac clip.mp4
q -i clip.mp4 -c:v copy -c:a pcm_s16le clip.mov
q -f lavfi -i testsrc2=size=541x301:rate=30 -t 3 -c:v libx264 -pix_fmt yuv444p odd.mp4
# Written to a pipe, so it has no stored length (like a browser recording).
q -f lavfi -i testsrc2=size=320x240:rate=30 -t 4 -c:v libvpx-vp9 -b:v 200k -f webm - > nodur.webm
# Variable frame rate: 60 fps for two seconds, then 20 fps.
q -f lavfi -i testsrc2=size=320x240:rate=60 -vf "select='lt(n,120)+not(mod(n,3))'" \
  -fps_mode vfr -t 6 -c:v libx264 -pix_fmt yuv420p vfr.mp4
cp clip.mp4 "with space.mp4"
echo "not a video" > notes.txt

# --- Helpers ----------------------------------------------------------------------
pass=0; fail=0; skip=0
out=""
run() {   # label, expected exit code, command...
  local label=$1 want=$2 code r; shift 2
  out=$("$@" </dev/null 2>&1); code=$?
  if [[ $code == "$want" ]]; then pass=$((pass+1)); r=PASS; else fail=$((fail+1)); r=FAIL; fi
  echo "=== $r [$label] exit=$code (want $want)"
  tr '\r' '\n' <<<"$out" | grep -vE '^(frame=|\[libx264|\[libvpx|$)' | sed 's/^/    /'
}
facts() {   # file -> size, length, picture size, frame rate, audio
  local p; p=$(ffmpeg -hide_banner -i "$1" 2>&1)
  echo "    -> $1: $(wc -c < "$1" | tr -d ' ') bytes," \
    "$(grep -oE 'Duration: [0-9:.]+' <<<"$p")," \
    "$(grep -m1 'Video:' <<<"$p" | grep -oE ', [0-9]+x[0-9]+' | head -1)," \
    "fps=$(grep -m1 'Video:' <<<"$p" | grep -oE '[0-9.]+ fps')," \
    "audio=$(grep -m1 'Audio:' <<<"$p" | sed -E 's/.*Audio: ([a-z0-9_]+).*/\1/')"
}
check() {
  if eval "$1"; then pass=$((pass+1)); echo "    PASS $1"; else fail=$((fail+1)); echo "    FAIL $1"; fi
}
size() { wc -c < "$1" | tr -d ' '; }
vfr() { ffmpeg -nostdin -hide_banner -i "$1" -vf vfrdet -an -f null - 2>&1 | grep -oE 'VFR:[0-9.]+'; }
T() { /bin/bash "$tool" "$@"; }

# --- Modes ------------------------------------------------------------------------
run "help" 0 T -h
run "info" 0 T -i
run "fix" 0 T -f clip.mp4;                      facts clip-fixed.mp4
run "fix again, no overwrite" 0 T -f clip.mp4;  check '[[ -f clip-fixed-2.mp4 ]]'
run "fix a variable frame rate clip" 0 T -f vfr.mp4
check '[[ $(vfr vfr.mp4) != VFR:0.000000 ]]'
check '[[ $(vfr vfr-fixed.mp4) == VFR:0.000000 ]]'
run "webm" 0 T -w clip.mp4;                     facts clip.webm
run "compress mov (pcm audio)" 0 T -c clip.mov; facts clip-compressed.mp4

# --- Size limit ---------------------------------------------------------------------
run "size 0.5" 0 T -s 0.5 clip.mp4;             facts clip-compressed-2.mp4
check '(( $(size clip-compressed-2.mp4) <= 500000 ))'
run "webm size 0.4" 0 T -w -s 0.4 clip.mp4;     facts clip-2.webm
check '(( $(size clip-2.webm) <= 400000 ))'
run "already under limit" 0 T -s 100 clip.mp4
run "impossible size, no terminal" 1 T -s 0.01 clip.mp4
run "low quality size, no terminal" 1 T -s 0.1 clip.mp4
run "no-length webm with size" 0 T -w -s 0.05 nodur.webm; facts nodur-small.webm

# --- Trim -----------------------------------------------------------------------------
run "trim 2-5" 0 T -t 2-5 clip.mp4;             facts clip-compressed-3.mp4
run "trim 9- (to end)" 0 T -c -t 9- clip.mp4;   facts clip-compressed-4.mp4
run "trim -3 (from start)" 0 T -c -t -3 clip.mp4; facts clip-compressed-5.mp4
run "trim end past the video: clamped" 0 T -c -t 5-50 clip.mp4; facts clip-compressed-6.mp4
run "trim M:SS with fix" 0 T -f -t 0:01-0:02.5 clip.mp4; facts clip-fixed-3.mp4
run "trim starts past the end" 1 T -c -t 20-30 clip.mp4
run "trim reversed" 1 T -c -t 5-2 clip.mp4
run "trim not a time" 1 T -c -t abc clip.mp4
run "trim three parts" 1 T -c -t 1-2-3 clip.mp4
run "trim too short" 1 T -c -t 1-1.1 clip.mp4

# --- Bad input ------------------------------------------------------------------------
run "missing file" 1 T -c nope.mp4
run "not a video" 1 T -c notes.txt
run "bad -s" 1 T -s abc clip.mp4
run "bad -q" 1 T -c -q 99 clip.mp4
run "-f with -s" 1 T -f -s 1 clip.mp4
run "two modes" 1 T -f -w clip.mp4
run "no mode, no terminal" 1 T clip.mp4
run "no file, no terminal" 1 T -c
run "too many args" 1 T -c with space.mp4

# --- Awkward files ----------------------------------------------------------------------
run "odd dimensions" 0 T -c odd.mp4;            facts odd-compressed.mp4
run "webm width flag" 0 T -w -W 200 odd.mp4;    facts odd.webm
run "spaces in names, with -o" 0 T -c -o "out dir" "with space.mp4"
facts "out dir/with space-compressed.mp4"
check '! ls | grep -q pass'   # no two-pass log files left behind

# --- Missing encoders (fake ffmpeg) -----------------------------------------------------
realpath_env=$PATH
export PATH="$stub:$PATH"
if "$real" -hide_banner -encoders 2>/dev/null | grep -q h264_videotoolbox; then
  HIDE='libx264' run "no libx264: info" 0 T -i
  HIDE='libx264' run "no libx264: compress" 0 T -c -o vt clip.mp4; facts vt/clip-compressed.mp4
  HIDE='libx264' run "no libx264: fix" 0 T -f -o vt clip.mp4;      facts vt/clip-fixed.mp4
  HIDE='libx264' run "no libx264: size below the encoder's floor" 1 T -s 0.5 -o vt clip.mp4
  check '[[ ! -e vt/clip-compressed-2.mp4 ]]'
  HIDE='libx264' run "no libx264: size, scaled down" 0 T -s 0.5 -W 270 -o vt clip.mp4
  check '(( $(size vt/clip-compressed-2.mp4) <= 500000 ))'
else
  skip=$((skip+1)); echo "=== SKIP [h264_videotoolbox fallback] this ffmpeg doesn't have the encoder"
fi
HIDE='libx264|videotoolbox|libvpx' run "no video encoders: info" 0 T -i
HIDE='libx264|videotoolbox|libvpx' run "no video encoders: compress" 1 T -c clip.mp4
HIDE='libx264|videotoolbox|libvpx' run "no video encoders: webm" 1 T -w clip.mp4
HIDE=' aac' run "no aac: pcm audio dropped" 0 T -c -o na clip.mov;  facts na/clip-compressed.mp4
HIDE=' aac' run "no aac: aac audio copied" 0 T -c -o na clip.mp4;   facts na/clip-compressed-2.mp4
run "no ffmpeg" 1 env PATH="$work/empty" /bin/bash "$tool" -c clip.mp4
export PATH=$realpath_env

# --- Config file --------------------------------------------------------------------------
has() { grep -qF -- "$1" <<<"$out"; }
# setconf <lines...>: write the config file, one argument per line.
setconf() { mkdir -p "$(dirname "$conf")"; printf '%s\n' "$@" > "$conf"; }
rm -f "$conf"
run "no config file is fine" 0 T -c -o cfgout clip.mp4;  check 'has "quality 23"'
setconf '# my settings' '' 'mp4_crf = 35' 'webm_maxw="200"'
run "config overrides the defaults" 0 T -c -o cfgout clip.mp4
check 'has "quality 35" && [[ -f cfgout/clip-compressed-2.mp4 ]]'
run "config value used by -w" 0 T -w -o cfgout clip.mp4;  check 'has "at most 200px wide"'
run "an option beats the config" 0 T -c -q 30 -W 300 -o cfgout clip.mp4
check 'has "quality 30" && has "at most 300px wide" && ! has "quality 35"'
setconf 'indir=~/Pics'
run "~ at the start of a value" 0 T -h;                  check 'has "$HOME/Pics. The original"'
setconf 'indir=$HOME/Pics'
run "\$HOME at the start of a value" 0 T -h;             check 'has "$HOME/Pics. The original"'
setconf 'mp4_crf=35' 'speed=3'
run "unknown setting" 1 T -c -o cfgout clip.mp4
check 'has "$conf, line 2: unknown setting \"speed\"."'
setconf 'mp4_crf=35' 'just some words'
run "malformed line" 1 T -c clip.mp4;                    check 'has "$conf, line 2: expected NAME=value"'
setconf 'indir="oops'
run "unclosed quote" 1 T -c clip.mp4;                    check 'has "$conf, line 1: indir has an opening quote"'
setconf '' 'mp4_crf=99'
run "bad quality" 1 T -c clip.mp4
check 'has "$conf, line 2: mp4_crf needs a whole number from 0 to 63 (got \"99\")."'
setconf 'fix_fps=0'
run "bad frame rate" 1 T -f clip.mp4;                    check 'has "$conf, line 1: fix_fps needs a frame rate"'
setconf 'webm_maxw=8'
run "bad width" 1 T -w clip.mp4;                         check 'has "webm_maxw needs a whole number from 16 to"'
setconf 'size_overhead=100'
run "bad overhead" 1 T -c clip.mp4;                      check 'has "size_overhead needs a whole number from 0 to 99"'
setconf 'pick_max=lots'
run "bad count" 1 T -i;                                  check 'has "pick_max needs a whole number"'
setconf 'indir='
run "empty indir" 1 T -i;                                check 'has "indir can'"'"'t be empty"'
setconf 'mp4_crf=35'
run "-h shows the config path" 0 T -h;                   check 'has "Config file: $conf"'
rm -f "$conf"
XDG_CONFIG_HOME='' HOME=$work/home run "-h without XDG_CONFIG_HOME" 0 T -h
check 'has "Config file: $work/home/.config/android-tools/vid-tool.conf"'

# --- Menus and prompts (through a real terminal) ------------------------------------------
if command -v expect >/dev/null; then
  if expect -f "$here/prompts.exp" "$tool" "$work" "$stub"; then
    pass=$((pass+1)); echo "=== PASS [prompts]"
  else
    fail=$((fail+1)); echo "=== FAIL [prompts]"
  fi
else
  skip=$((skip+1)); echo "=== SKIP [prompts] expect not found"
fi

# --- Pickers with fzf (through a real terminal, with a fake fzf) ---------------------------
out=""
has() { grep -qF -- "$1" <<<"$out"; }
fzf_logged() { grep -qF -- "$1" "$FAKE_FZF_LOG"; }
# shellcheck disable=SC2034  # used inside the single-quoted strings that check evaluates
tab=$'\t'
# trun <label> <expected exit code> <command...>: like run, but the command has a
# terminal on standard input, output and error. T means the tool.
trun() {
  local label=$1 want=$2 code r; shift 2
  if [[ $1 == T ]]; then shift; set -- /bin/bash "$tool" "$@"; fi
  : > "$FAKE_FZF_LOG"; rm -f "$work/fzf.count"
  out=$(/usr/bin/expect "$here/../../tests/tty.exp" "$@" 2>&1); code=$?
  out=$(tr '\r' '\n' <<<"$out" | grep -vE '^(frame=|\[libx264|\[libvpx|$)')
  if [[ $code == "$want" ]]; then pass=$((pass+1)); r=PASS; else fail=$((fail+1)); r=FAIL; fi
  echo "=== $r [$label] exit=$code (want $want)"
  sed 's/^/    /' <<<"$out"
}
if command -v expect >/dev/null; then
  export PATH="$fakes:$PATH"
  # The two folders the file picker lists: "Screen 2.mp4" is the newer.
  fh="$work/fhome"
  mkdir -p "$fh/Desktop"
  cp odd.mp4 "$fh/Desktop/Screen 1.mp4"; cp odd.mp4 "$fh/Desktop/Screen 2.mp4"
  touch -t 202001010000 "$fh/Desktop/Screen 1.mp4"
  echo "a note" > "$fh/Desktop/notes.txt"

  ANDROID_TOOLS_NO_FZF= FAKE_FZF_SEQ=3 TTY_PROMPT='keep it all: ' TTY_REPLY='' trun "fzf action menu: compress" 0 T -o pick clip.mp4
  check 'has "Same thing in one line: vid-tool -c " && [[ -f pick/clip-compressed.mp4 ]]'
  check '! has "What do you want to do?" && ! has "1) It plays"'
  check 'fzf_logged "--prompt=Action> " && fzf_logged "--header=What do you want to do?" && fzf_logged "--with-nth=2"'
  check 'fzf_logged "  in: 1${tab}It plays in slow motion: fix it" && fzf_logged "  in: 4${tab}Get it under a size limit, as MP4"'
  check '(( $(grep -c "^fzf " "$FAKE_FZF_LOG") == 1 )) && ! fzf_logged "--preview"'

  ANDROID_TOOLS_NO_FZF= FAKE_FZF_SEQ=esc trun "fzf action menu: Esc exits" 1 T -o pick clip.mp4
  check 'has "Nothing chosen; stopping."'
  ANDROID_TOOLS_NO_FZF= FAKE_FZF_SEQ=none trun "fzf action menu: no match exits" 1 T -o pick clip.mp4
  check 'has "Nothing chosen; stopping."'

  # An unavailable choice says so and asks again.
  PATH="$stub:$PATH" HIDE=libvpx ANDROID_TOOLS_NO_FZF= FAKE_FZF_SEQ="2 3" TTY_PROMPT='keep it all: ' TTY_REPLY='' trun "fzf action menu: unavailable choice asks again" 0 T -o pick clip.mp4
  check 'has "Not available: this ffmpeg has no VP9 encoder" && has "Same thing in one line: vid-tool -c "'
  check '(( $(grep -c "^fzf " "$FAKE_FZF_LOG") == 2 )) && fzf_logged "  in: 2${tab}Make a small WebM to share (no audio)  (not available: this ffmpeg has no VP9 encoder"'

  # Low quality choices, reached with -s.
  ANDROID_TOOLS_NO_FZF= FAKE_FZF_SEQ=1 trun "fzf low quality menu: scale down" 0 T -s 0.25 -o pick clip.mp4
  check 'fzf_logged "--prompt=Next> " && fzf_logged "  in: 1${tab}Scale down to " && fzf_logged "  in: 4${tab}Cancel" && has "Saved: "'
  ANDROID_TOOLS_NO_FZF= FAKE_FZF_SEQ=2 TTY_PROMPT='Enter to go back\): ' TTY_REPLY='2-6' trun "fzf low quality menu: trim" 0 T -s 0.25 -o pick clip.mp4
  check 'has "Keep which part?" && has "Saved: "'
  ANDROID_TOOLS_NO_FZF= FAKE_FZF_SEQ=4 trun "fzf low quality menu: cancel" 1 T -s 0.25 -o pick clip.mp4
  check 'has "Cancelled; nothing was saved."'
  ANDROID_TOOLS_NO_FZF= FAKE_FZF_SEQ=esc trun "fzf low quality menu: Esc cancels" 1 T -s 0.25 -o pick clip.mp4
  check 'has "Cancelled; nothing was saved."'

  # File picker, then the action menu.
  HOME="$fh" ANDROID_TOOLS_NO_FZF= FAKE_FZF_SEQ="2 3" TTY_PROMPT='keep it all: ' TTY_REPLY='' trun "fzf file picker, then action menu" 0 T
  check '[[ -f "$fh/Desktop/Screen 1-compressed.mp4" && ! -e "$fh/Desktop/Screen 2-compressed.mp4" ]]'   # the picker was asked for line 2, the older file
  check 'fzf_logged "--prompt=Video> " && fzf_logged "--header=Pick a video from $fh/Desktop (newest first)"'
  check 'fzf_logged "--preview=ffmpeg -nostdin -hide_banner -i {3..}" && fzf_logged "--delimiter=$tab"'
  check 'grep -qE "^  in: 1${tab}Screen 2.mp4  \(.*\)${tab}$fh/Desktop/Screen 2.mp4$" "$FAKE_FZF_LOG"'
  check 'grep -qE "^  in: 2${tab}Screen 1.mp4  \(.*\)${tab}$fh/Desktop/Screen 1.mp4$" "$FAKE_FZF_LOG"'
  check '! fzf_logged "notes.txt"'
  HOME="$fh" ANDROID_TOOLS_NO_FZF= FAKE_FZF_SEQ=esc trun "fzf file picker: Esc exits" 1 T
  check 'has "No video chosen." && ! fzf_logged "Action>"'
  HOME="$fh" ANDROID_TOOLS_NO_FZF= FAKE_FZF_SEQ=1 TTY_PROMPT='keep it all: ' TTY_REPLY='' trun "fzf: a file given needs no file picker" 0 T -f -o pick "$fh/Desktop/Screen 1.mp4"
  check '[[ ! -s $FAKE_FZF_LOG ]]'

  # fzf stays off when switched off, or when standard error is not the terminal.
  # Answering 4 (Cancel) at the numbered menu exits 1. Had fzf been used, the fake
  # would have picked line 1 and the run would have succeeded.
  ANDROID_TOOLS_NO_FZF=1 TTY_PROMPT='> ' TTY_REPLY=4 trun "ANDROID_TOOLS_NO_FZF keeps the numbered menu" 1 T -s 0.25 -o pick clip.mp4
  check 'has "4) Cancel" && has "Cancelled; nothing was saved." && [[ ! -s $FAKE_FZF_LOG ]]'
  # Standard error is not the terminal here, so the menu is the numbered one too
  # (it draws on standard error, so the answer is typed blind).
  ANDROID_TOOLS_NO_FZF= TTY_BLIND=1 TTY_REPLY=4 trun "stderr not a terminal: numbered menu, not fzf" 1 /bin/bash -c 'exec /bin/bash "$0" "$@" 2>/dev/null' "$tool" -s 0.25 -o pick clip.mp4
  check '[[ ! -s $FAKE_FZF_LOG ]]'
else
  skip=$((skip+1)); echo "=== SKIP [fzf pickers] expect not found"
fi

echo
echo "TOTAL pass=$pass fail=$fail skip=$skip"
if [[ -n ${CI:-} ]] && (( skip > 0 )); then echo "CI is set, so a skip counts as a failure." >&2; exit 1; fi
(( fail == 0 ))
