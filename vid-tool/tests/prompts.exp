#!/usr/bin/expect -f
# Drives vid-tool's menus and prompts through a real terminal.
# Called by tests/run, which makes the clips:  prompts.exp <tool> <work dir> <stub dir>
# Exits non-zero if any case fails.
lassign $argv tool work stub
set timeout 180
set failed 0
cd $work
file mkdir pick

proc finish {label want} {
  global failed
  expect {
    eof { }
    timeout { puts "\n### FAIL $label: timed out"; incr failed; catch {close}; catch {wait}; return }
  }
  set code [lindex [wait] 3]
  if {$code == $want} {
    puts "\n### PASS $label exit=$code"
  } else {
    puts "\n### FAIL $label exit=$code (want $want)"
    incr failed
  }
}

puts "\n##### menu: compress, with a bad trim then a good one"
spawn /bin/bash $tool -o pick clip.mp4
expect "> "
send "9\r"
expect "Enter 1, 2, 3 or 4."
send "3\r"
expect "keep it all: "
send "40-50\r"
expect "only 0:12 long"
send "1-3\r"
expect "Same thing in one line: vid-tool -c -t 1-3"
finish "menu compress trim" 0

puts "\n##### menu: size limit, bad number, then low-quality prompt -> scale down"
spawn /bin/bash $tool -o pick clip.mp4
expect "> "
send "4\r"
expect "Size limit in MB"
send "lots\r"
expect "Enter a number"
send "0.25\r"
expect "keep it all: "
send "\r"
expect "likely to look blocky"
expect "> "
send "1\r"
expect "Same thing in one line: vid-tool -c -s 0.25 -W"
finish "menu size, scale down" 0

puts "\n##### flags: low-quality prompt -> trim"
spawn /bin/bash $tool -s 0.25 -o pick clip.mp4
expect "likely to look blocky"
expect "> "
send "2\r"
expect "Keep which part"
send "2-6\r"
finish "low-quality prompt, trim" 0

puts "\n##### flags: low-quality prompt -> cancel"
spawn /bin/bash $tool -s 0.25 -o pick clip.mp4
expect "> "
send "4\r"
expect "nothing was saved"
finish "low-quality prompt, cancel" 1

puts "\n##### menu with an unavailable mode"
set oldpath $env(PATH)
set env(PATH) "$stub:$env(PATH)"
set env(HIDE) "libvpx"
spawn /bin/bash $tool -o pick clip.mp4
expect "not available"
expect "> "
send "2\r"
expect "Not available"
send "3\r"
expect "keep it all: "
send "0-1\r"
finish "unavailable mode" 0
set env(PATH) $oldpath
unset env(HIDE)

puts "\n##### file picker from the default folder, then menu"
set env(HOME) $work/home
file mkdir $work/home/Desktop
file copy -force odd.mp4 "$work/home/Desktop/Screen Recording 1.mp4"
exec touch $work/home/Desktop/notes.txt
spawn /bin/bash $tool
expect "Pick a video"
expect "> "
send "7\r"
expect "> "
send "1\r"
expect "What do you want to do"
expect "> "
send "3\r"
expect "keep it all: "
send "\r"
finish "file picker" 0
if {![file exists "$work/home/Desktop/Screen Recording 1-compressed.mp4"]} {
  puts "### FAIL file picker: output not saved next to the original"
  incr failed
}

puts "\n##### prompts: $failed failed"
exit [expr {$failed > 0}]
