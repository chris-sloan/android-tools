#!/bin/bash
# Tests for adb-shot. Needs nothing installed: perl and xxd ship with macOS,
# and adb, osascript and open are replaced with fakes.
#
#   adb-shot/tests/run
#
# The fake adb is shared with adb-record (tests/fakes/adb at the top of the
# repo). The fake osascript and open live in adb-shot/tests/fakes. All three
# log how they were called, so nothing reaches a device, the real clipboard or
# Preview. HOME points into a temp folder, which is removed on exit. Runs
# adb-shot under /bin/bash, which on macOS is bash 3.2.
#
# The device picker uses fzf when fzf is on PATH and standard input and error
# are terminals. This script hides fzf from every other check by setting
# ANDROID_TOOLS_NO_FZF=1 (the tool's documented switch), and the fzf checks
# turn it back on. Those checks need a terminal, so they run the tool through
# tests/tty.exp (expect, which ships with macOS), with a fake fzf (tests/fakes/fzf)
# first on PATH. A real fzf on the machine is never used. Without expect those
# checks print a SKIP line. Piped input is checked too: it keeps the select menu
# even with fzf on PATH.
#
# Floor points: 1 to 4 are met. Point 5 is met by the top-level tests/run,
# which runs bash -n and shellcheck on this script. This script does not lint
# itself, so it needs nothing installed.

here=$(cd "$(dirname "$0")" && pwd)
tool="$here/../adb-shot"
shared="$here/../../tests/fakes"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/empty" "$work/home"
cd "$work" || exit 1
export HOME="$work/home"
export FAKE_LOG="$work/fake.log" FAKE_STATE="$work"
export PATH="$here/fakes:$shared:$PATH"
# The tool reads its config from here, never from the real ~/.config.
export XDG_CONFIG_HOME="$work/config"
conf="$XDG_CONFIG_HOME/android-tools/adb-shot.conf"

export ANDROID_TOOLS_NO_FZF=1 FAKE_FZF_LOG="$work/fzf.log"

# --- Helpers ----------------------------------------------------------------------
pass=0; fail=0; skip=0
out=""
# run <label> <expected exit code> <command...>
# Standard input is INPUT (printf %b), sent after DELAY seconds if set. With
# neither set, the command sees an empty, closed input.
run() {
  local label=$1 want=$2 code r; shift 2
  : > "$FAKE_LOG"; : > "$FAKE_FZF_LOG"; rm -f "$work/fzf.count"
  out=$( { [[ -n $DELAY ]] && sleep "$DELAY"; printf '%b' "$INPUT"; } | "$@" 2>&1 ); code=$?
  if [[ $code == "$want" ]]; then pass=$((pass+1)); r=PASS; else fail=$((fail+1)); r=FAIL; fi
  echo "=== $r [$label] exit=$code (want $want)"
  tr '\r' '\n' <<<"$out" | sed 's/^/    /'
}
# trun <label> <expected exit code> <command...>: like run, but the command has
# a terminal on standard input, output and error (through expect). A command
# of T means the tool, since expect can't run a shell function.
trun() {
  local label=$1 want=$2 code r; shift 2
  if [[ $1 == T ]]; then shift; set -- /bin/bash "$tool" "$@"; fi
  : > "$FAKE_LOG"; : > "$FAKE_FZF_LOG"; rm -f "$work/fzf.count"
  out=$(/usr/bin/expect "$here/../../tests/tty.exp" "$@" 2>&1 </dev/null); code=$?
  out=${out//$'\r'/}
  if [[ $code == "$want" ]]; then pass=$((pass+1)); r=PASS; else fail=$((fail+1)); r=FAIL; fi
  echo "=== $r [$label] exit=$code (want $want)"
  sed 's/^/    /' <<<"$out"
}
fzf_logged() { grep -qF -- "$1" "$FAKE_FZF_LOG"; }
check() {
  if eval "$1"; then pass=$((pass+1)); echo "    PASS $1"; else fail=$((fail+1)); echo "    FAIL $1"; fi
}
has() { grep -qF -- "$1" <<<"$out"; }
logged() { grep -qF -- "$1" "$FAKE_LOG"; }
png() { [[ $(head -c 4 "$1" | xxd -p) == 89504e47 ]]; }
T() { /bin/bash "$tool" "$@"; }
two=$'SERIALAAA\tdevice\nSERIALBBB\tdevice\n'
# shellcheck disable=SC2034  # used inside the single-quoted strings that check evaluates
tab=$'\t'
fold='Display 111\n  powerMode=Off\nDisplay 222\n  powerMode=On\n'

# --- Help and errors ----------------------------------------------------------------
run "help" 0 T -h;                                       check 'has "Usage: adb-shot"'
run "unknown option" 1 T -z;                             check 'has "Usage: adb-shot"'
run "too many arguments" 1 T -C two words;               check 'has "Too many arguments"'
run "no adb on PATH" 1 env PATH="$work/empty" /bin/bash "$tool" -C x
check 'has "adb not found on PATH."'
FAKE_ADB_DEVICES='' run "no devices" 1 T -C -o out x;    check 'has "No devices connected"'
FAKE_ADB_DEVICES=$'SERIALAAA\tunauthorized\n' run "only an unauthorized device" 1 T -C -o out x
check 'has "No devices connected"'
FAKE_ADB_CAPFAIL=1 run "screencap fails" 1 T -C -o out capfail
check 'has "Screenshot failed." && [[ ! -e out/capfail.png ]]'
FAKE_ADB_NOPNG=1 run "device returns no PNG" 1 T -C -o out nopng
check 'has "the device didn'"'"'t return a PNG" && [[ ! -e out/nopng.png ]]'
FAKE_OSASCRIPT_EXIT=1 run "clipboard copy fails, shot still saved" 0 T -o out clipfail
check 'has "Couldn'"'"'t copy to the clipboard." && png out/clipfail.png'

# --- One shot ----------------------------------------------------------------------------
run "one device, copied by default" 0 T -o out basket
check 'png out/basket.png && has "Saved: out/basket.png" && has "Copied to clipboard."'
check 'logged "adb -s emulator-5554 exec-out screencap -p"'
check 'logged "osascript" && logged "out/basket.png"'
check '! logged "open "'
run "never overwrites" 0 T -C -o out basket
check '[[ -f out/basket-2.png ]] && has "Saved: out/basket-2.png"'
run "-C does not copy" 0 T -C -o out nocopy
check '! logged "osascript" && ! has "Copied"'
run "-c copies" 0 T -c -o out copyme;                    check 'logged "osascript" && has "Copied to clipboard."'
run ".png in the name is not doubled" 0 T -C -o out dotpng.png
check '[[ -f out/dotpng.png && ! -e out/dotpng.png.png ]]'
run "default name uses the model" 0 T -C -o named
check 'ls named | grep -q "^screenshot-Pixel-9-Pro-[0-9]*-[0-9]*\.png$"'
run "default folder is HOME/Desktop" 0 T -C desk
check '[[ -f "$HOME/Desktop/desk.png" ]]'
run "-o makes the folder" 0 T -C -o "new/sub dir" deep;   check '[[ -f "new/sub dir/deep.png" ]]'
FAKE_ADB_WARN=1 run "warning text before the PNG is stripped" 0 T -C -o out warn
check 'png out/warn.png'
run "-p opens the image" 0 T -C -p -o out openme;        check 'logged "open out/openme.png"'
run "-d counts down first" 0 T -C -d 1 -o out late;      check 'png out/late.png'

# --- Displays ----------------------------------------------------------------------------
FAKE_ADB_SF=$fold run "foldable: picks the display that is on" 0 T -C -o out fold
check 'logged "screencap -p -d 222"'
run "one screen: no display id" 0 T -C -o out onescreen; check '! logged "screencap -p -d"'
run "-D picks a display" 0 T -C -D 7 -o out disp;        check 'logged "screencap -p -d 7"'
FAKE_ADB_SF=$fold run "-D wins over the pick" 0 T -C -D 7 -o out disp2
check 'logged "screencap -p -d 7" && ! logged "-d 222"'
run "-L lists displays" 0 T -L;                          check 'has "Display 4619827259835644672" && ! logged "screencap"'

# --- Several devices ------------------------------------------------------------------
FAKE_ADB_DEVICES=$two run "two devices, input ends" 1 T -C -o out x
check 'has "Select a device:" && ! logged "screencap"'
INPUT='2\n' FAKE_ADB_DEVICES=$two run "two devices, 2 piped to the menu" 0 T -C -o out second
check 'logged "adb -s SERIALBBB exec-out"'
INPUT='9\nx\n1\n' FAKE_ADB_DEVICES=$two run "two devices, bad answers then 1" 0 T -C -o out third
check 'logged "adb -s SERIALAAA exec-out"'

# --- Device picker with fzf ----------------------------------------------------------------
# Piped input keeps the select menu even with fzf on PATH and fzf switched on.
ANDROID_TOOLS_NO_FZF= INPUT='2\n' FAKE_ADB_DEVICES=$two run "piped input: select menu, not fzf" 0 T -C -o out piped
check 'has "Select a device:" && logged "adb -s SERIALBBB exec-out" && [[ ! -s $FAKE_FZF_LOG ]]'
if command -v expect >/dev/null; then
  ANDROID_TOOLS_NO_FZF= FAKE_FZF_SEQ=2 FAKE_ADB_DEVICES=$two trun "terminal and fzf: fzf picks device 2" 0 T -C -o out fz
  check 'logged "adb -s SERIALBBB exec-out" && ! has "Select a device:" && [[ -f out/fz.png ]]'
  check 'fzf_logged "  in: 1${tab}Pixel 9 Pro  [SERIALAAA]" && fzf_logged "  in: 2${tab}Pixel 9 Pro  [SERIALBBB]"'
  check 'fzf_logged "--with-nth=2" && fzf_logged "--prompt=Device> " && fzf_logged "--header=Select a device" && fzf_logged "--height=40%"'
  check '(( $(grep -c "^fzf " "$FAKE_FZF_LOG") == 1 ))'
  ANDROID_TOOLS_NO_FZF= FAKE_FZF_SEQ=1 FAKE_ADB_DEVICES=$two trun "fzf picks device 1" 0 T -C -o out fz1
  check 'logged "adb -s SERIALAAA exec-out"'
  ANDROID_TOOLS_NO_FZF= FAKE_FZF_SEQ=esc FAKE_ADB_DEVICES=$two trun "fzf: Esc exits" 1 T -C -o out fzesc
  check 'has "No device selected." && ! logged "screencap" && [[ ! -e out/fzesc.png ]]'
  ANDROID_TOOLS_NO_FZF= FAKE_FZF_SEQ=none FAKE_ADB_DEVICES=$two trun "fzf: no match exits" 1 T -C -o out fznone
  check 'has "No device selected." && ! logged "screencap"'
  ANDROID_TOOLS_NO_FZF= FAKE_FZF_SEQ=2 FAKE_ADB_DEVICES=$two trun "fzf: -L uses the picked device" 0 T -L
  check 'logged "adb -s SERIALBBB shell dumpsys SurfaceFlinger --display-id"'
  ANDROID_TOOLS_NO_FZF= trun "fzf: one device needs no picker" 0 T -C -o out fzone
  check '[[ ! -s $FAKE_FZF_LOG ]] && logged "adb -s emulator-5554 exec-out"'
  # Standard error is not the terminal here, so fzf is not used. The select menu
  # (which draws on standard error) is answered blind.
  ANDROID_TOOLS_NO_FZF= TTY_BLIND=1 TTY_REPLY=2 FAKE_ADB_DEVICES=$two trun "stderr not a terminal: select menu, not fzf" 0 /bin/bash -c 'exec /bin/bash "$0" "$@" 2>/dev/null' "$tool" -C -o out noterr
  check 'logged "adb -s SERIALBBB exec-out" && [[ ! -s $FAKE_FZF_LOG ]]'
  ANDROID_TOOLS_NO_FZF=1 TTY_PROMPT='> ' TTY_REPLY=2 FAKE_ADB_DEVICES=$two trun "ANDROID_TOOLS_NO_FZF keeps select on a terminal" 0 T -C -o out nofzf
  check 'has "Select a device:" && logged "adb -s SERIALBBB exec-out" && [[ ! -s $FAKE_FZF_LOG ]]'
else
  skip=$((skip+1)); echo "=== SKIP [fzf picker on a terminal] expect not found"
fi

# --- Series (-n) read from standard input ---------------------------------------------
INPUT='\n\n\n' run "-n 3: full series" 0 T -n 3 -o out series
check 'png out/series-1.png && png out/series-2.png && png out/series-3.png && [[ ! -e out/series-4.png ]]'
# bash prints a read -p prompt only when input is a terminal, so none shows here.
check '(( $(grep -c "^Saved:" <<<"$out") == 3 )) && (( $(grep -c "^Copied" <<<"$out") == 3 ))'
check '(( $(grep -c "^osascript" "$FAKE_LOG") == 3 ))'
INPUT='\n\n' run "-n 2 with -p opens every image" 0 T -C -p -n 2 -o out opened
check 'logged "open out/opened-1.png out/opened-2.png"'
INPUT='\n\n' run "-n 3: input cut off after two" 1 T -C -n 3 -o out cut
check 'has "Input ended after 2 of 3 shots"'
check 'png out/cut-1.png && png out/cut-2.png && [[ ! -e out/cut-3.png ]]'
run "-n 2: no input at all" 1 T -C -n 2 -o out none
check 'has "Input ended after 0 of 2 shots" && [[ ! -e out/none-1.png ]]'
INPUT='\n' run "-n 1 needs no input" 0 T -C -n 1 -o out single
check '[[ -f out/single.png ]]'

# --- Config file ------------------------------------------------------------------------
# setconf <lines...>: write the config file, one argument per line.
setconf() { mkdir -p "$(dirname "$conf")"; printf '%s\n' "$@" > "$conf"; }
rm -f "$conf"
run "no config file is fine" 0 T -o out noconf;          check 'png out/noconf.png && has "Copied to clipboard."'
setconf '# my settings' '' 'copy = 0' 'open_after="1"' "outdir='$work/cfgout'" 'delay=1'
run "config overrides the defaults" 0 T cfg
check 'png cfgout/cfg.png && ! logged "osascript" && logged "open $work/cfgout/cfg.png"'
run "an option beats the config" 0 T -c -o out cfg2
check 'png out/cfg2.png && logged "osascript" && has "Copied to clipboard."'
setconf 'copy=0'
run "-c beats copy=0 and -C beats copy=1" 0 T -c -o out cfg3;  check 'logged "osascript"'
setconf 'outdir=$HOME/Pics'
run "\$HOME at the start of a value" 0 T -C cfg4;        check 'png "$HOME/Pics/cfg4.png"'
setconf 'outdir=~/Shots'
run "~ at the start of a value" 0 T -C cfg5;             check 'png "$HOME/Shots/cfg5.png"'
setconf 'copy=0' 'speed=3'
run "unknown setting" 1 T -o out x
check 'has "$conf, line 2: unknown setting \"speed\"." && ! logged "screencap"'
setconf 'copy=0' 'just some words'
run "malformed line" 1 T -o out x;                       check 'has "$conf, line 2: expected NAME=value"'
setconf 'outdir="oops'
run "unclosed quote" 1 T -o out x;                       check 'has "$conf, line 1: outdir has an opening quote"'
setconf '' 'delay=soon'
run "bad number" 1 T -o out x
check 'has "$conf, line 2: delay needs a whole number" && ! logged "screencap"'
setconf 'copy=2'
run "bad flag" 1 T -o out x;                             check 'has "$conf, line 1: copy needs 0 or 1"'
setconf 'outdir='
run "empty outdir" 1 T -o out x;                         check 'has "outdir can'"'"'t be empty"'
setconf 'delay=2'
run "-h shows the config path" 0 T -h;                   check 'has "Config file: $conf" && has "(default 2)"'
rm -f "$conf"
XDG_CONFIG_HOME='' run "-h without XDG_CONFIG_HOME" 0 T -h; check 'has "Config file: $HOME/.config/android-tools/adb-shot.conf"'

# --- Lint -------------------------------------------------------------------------------
run "bash -n" 0 bash -n "$tool"
run "bash -n (this script)" 0 bash -n "$here/run"   # not $0: it may be relative, and we cd'd away

echo
echo "$pass passed, $fail failed, $skip skipped."
if [[ -n ${CI:-} ]] && (( skip > 0 )); then exit 1; fi
(( fail == 0 ))
