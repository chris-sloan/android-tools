#!/usr/bin/env bash
# adb-shot: take a screenshot on an Android device and save it to your Mac.
set -eo pipefail

# --- Defaults (edit these to taste) ------------------------------------------
outdir="$HOME/Desktop"  # where screenshots are saved
copy=1                  # 1 = also copy the image to the clipboard
open_after=0            # 1 = open the image in Preview afterwards
delay=0                 # seconds to wait before taking the shot

# --- Config file (overrides the defaults above; updates never touch it) -------
# Lines of NAME=value. Blank lines and lines starting with # are skipped. A
# value may be in "double" or 'single' quotes. A leading ~, $HOME or ${HOME}
# becomes your home folder. Only the names in the defaults block are allowed.
# The file is read as text, never run as a script.
die() { echo "$*" >&2; exit 1; }
conf_file="${XDG_CONFIG_HOME:-$HOME/.config}/android-tools/adb-shot.conf"
conf_names=" outdir copy open_after delay "

# check_setting <name> <value>: if the value is no good, print why and return 1.
check_setting() {
  case $1 in
    outdir) [[ -n $2 ]] || { echo "outdir can't be empty."; return 1; } ;;
    copy | open_after) [[ $2 == [01] ]] || { echo "$1 needs 0 or 1 (got \"$2\")."; return 1; } ;;
    delay)
      if [[ ! $2 =~ ^[0-9]+$ ]] || (( ${#2} > 4 )); then
        echo "delay needs a whole number of seconds, e.g. 5 (got \"$2\")."; return 1
      fi ;;
  esac
}

load_config() {
  [[ -f $conf_file ]] || return 0
  local line n=0 name val err dq='^"(.*)"$' sq="^'(.*)'\$"
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n + 1))
    line=${line#"${line%%[![:space:]]*}"}
    line=${line%"${line##*[![:space:]]}"}
    case $line in '' | '#'*) continue ;; esac
    [[ $line =~ ^([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=[[:space:]]*(.*)$ ]] ||
      die "$conf_file, line $n: expected NAME=value (got \"$line\")."
    name=${BASH_REMATCH[1]} val=${BASH_REMATCH[2]}
    case $conf_names in *" $name "*) ;; *) die "$conf_file, line $n: unknown setting \"$name\"." ;; esac
    if [[ $val =~ $dq || $val =~ $sq ]]; then
      val=${BASH_REMATCH[1]}
    elif [[ $val == [\"\']* ]]; then
      die "$conf_file, line $n: $name has an opening quote with no closing one."
    fi
    case $val in
      \~ | \~/*) val=$HOME${val:1} ;;
      '$HOME' | '$HOME/'*) val=$HOME${val:5} ;;
      '${HOME}' | '${HOME}/'*) val=$HOME${val:7} ;;
    esac
    err=$(check_setting "$name" "$val") || die "$conf_file, line $n: $err"
    printf -v "$name" '%s' "$val"
  done < "$conf_file"
}
load_config

usage() {
  cat <<EOF
Usage: adb-shot [-d seconds] [-n count] [-o dir] [-D display] [-c|-C] [-p] [-L] [name]

  name        Filename, e.g. "basket-overlap" (.png added if missing).
              Defaults to screenshot-<model>-<timestamp>.png.
              Never overwrites: adds -2, -3, ... if the file exists.
  -d seconds  Countdown before the shot, to get the screen ready (default $delay)
  -n count    Take several shots, one per Enter press (e.g. step-by-step bugs)
  -o dir      Where to save (default $outdir)
  -D id       Display to capture on multi-screen devices (e.g. foldables)
  -L          List the device's display IDs and exit
  -c / -C     Copy / don't copy the image to the clipboard (default: copy).
              With -n, each shot is copied as it is taken.
  -p          Open the image in Preview afterwards
  -h          Show this help

Config file: $conf_file
Settings there (outdir, copy, open_after, delay) replace the defaults; options win.
EOF
}

count=1
display=""
list_displays=0

while getopts "d:n:o:D:LcCph" opt; do
  case $opt in
    d) delay=$OPTARG ;;
    n) count=$OPTARG ;;
    o) outdir=$OPTARG ;;
    D) display=$OPTARG ;;
    L) list_displays=1 ;;
    c) copy=1 ;;
    C) copy=0 ;;
    p) open_after=1 ;;
    h) usage; exit 0 ;;
    *) usage; exit 1 ;;
  esac
done
shift $((OPTIND - 1))
name=${1:-}
if (( $# > 1 )); then
  echo "Too many arguments; quote names that contain spaces." >&2
  exit 1
fi

command -v adb >/dev/null || { echo "adb not found on PATH." >&2; exit 1; }

# --- fzf pickers ---------------------------------------------------------------
# With fzf installed and a terminal on standard input and standard error, a
# picker uses fzf. Otherwise it is the numbered select menu. Setting
# ANDROID_TOOLS_NO_FZF to anything non-empty turns fzf off.
use_fzf() {
  [[ -z ${ANDROID_TOOLS_NO_FZF:-} && -t 0 && -t 2 ]] && command -v fzf >/dev/null
}

# fzf_pick <prompt> <header> [preview command]
# Reads lines of "label" or "label<TAB>extra" on standard input. Sets $picked to
# the chosen line's position, counting from 1. Only the label is shown; extra is
# for the preview command ({3..}). Returns 1 if the user cancels.
fzf_pick() {
  local tab=$'\t' line args
  args=(--height=40% --reverse --delimiter="$tab" --with-nth=2 --prompt="$1> " --header="$2")
  [[ -z ${3:-} ]] || args+=(--preview="$3" --preview-window=wrap)
  line=$(awk '{ print NR "\t" $0 }' | fzf "${args[@]}") || return 1
  picked=${line%%"$tab"*}
}

# --- Pick a device -----------------------------------------------------------
serials=()
while read -r s state _; do
  [[ $state == "device" ]] && serials+=("$s")
done < <(adb devices | tail -n +2)

model_of() { adb -s "$1" shell getprop ro.product.model | tr -d '\r'; }

if (( ${#serials[@]} == 0 )); then
  echo "No devices connected (check 'adb devices' for unauthorized ones)." >&2
  exit 1
elif (( ${#serials[@]} == 1 )); then
  serial=${serials[0]}
else
  labels=()
  for s in "${serials[@]}"; do labels+=("$(model_of "$s")  [$s]"); done
  if use_fzf; then
    if fzf_pick "Device" "Select a device" < <(printf '%s\n' "${labels[@]}"); then
      serial=${serials[picked-1]}
    else
      echo "No device selected." >&2
      exit 1
    fi
  else
    echo "Select a device:"
    PS3="> "
    select _ in "${labels[@]}"; do
      if [[ $REPLY =~ ^[0-9]+$ ]] && (( REPLY >= 1 && REPLY <= ${#serials[@]} )); then
        serial=${serials[REPLY-1]}
        break
      fi
    done
  fi
  [[ -n $serial ]] || exit 1
fi

dev() { adb -s "$serial" "$@"; }
model=$(model_of "$serial")

if (( list_displays )); then
  dev shell dumpsys SurfaceFlinger --display-id | tr -d '\r'
  exit 0
fi

# --- Work out the filename(s) -------------------------------------------------
[[ -n $name ]] && base=${name%.png} || base="screenshot-${model// /-}-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$outdir"

next_file() {
  local f="$outdir/$1.png" n=2
  while [[ -e $f ]]; do f="$outdir/$1-$n.png"; n=$((n + 1)); done
  echo "$f"
}

# On multi-screen devices (foldables), screencap needs a display ID; without one
# it prints a warning into the PNG and may grab a screen that's switched off.
# Pick whichever physical display is currently powered on.
if [[ -z $display ]]; then
  display=$(dev shell dumpsys SurfaceFlinger | tr -d '\r' \
    | awk '/^Display [0-9]+$/ { id = $2 } /powerMode=On/ && id && !found { found = id } END { print found }')
fi

shoot() {
  local file=$1
  local args=(-p)
  [[ -n $display ]] && args+=(-d "$display")
  if ! dev exec-out screencap "${args[@]}" > "$file"; then
    rm -f "$file"
    echo "Screenshot failed." >&2
    exit 1
  fi
  # Strip any text screencap printed before the PNG data, then sanity-check it.
  perl -0777 -pi -e 's/\A.*?(?=\x89PNG)//s' "$file"
  if [[ $(head -c 4 "$file" | xxd -p) != "89504e47" ]]; then
    rm -f "$file"
    echo "Screenshot failed: the device didn't return a PNG." >&2
    exit 1
  fi
  echo "Saved: $file"
}

# Copy one image to the clipboard. The path is passed as an argument, not
# written into the AppleScript, so quotes in a filename can't break it.
# A failed copy is reported but doesn't stop a series.
copy_to_clipboard() {
  if osascript \
    -e 'on run argv' \
    -e 'set the clipboard to (read (POSIX file (item 1 of argv)) as «class PNGf»)' \
    -e 'end run' \
    "$1"; then
    echo "Copied to clipboard."
  else
    echo "Couldn't copy to the clipboard." >&2
  fi
}

countdown() {
  local i
  for (( i = delay; i > 0; i-- )); do printf '\r%s... ' "$i"; sleep 1; done
  (( delay > 0 )) && printf '\r      \r'
  return 0
}

# --- Take the shot(s) ----------------------------------------------------------
files=()
for (( i = 1; i <= count; i++ )); do
  if (( count > 1 )); then
    # Reads standard input, so answers can be piped in. If input ends early,
    # stop with an error instead of leaving a partial series.
    if ! read -r -p "Shot $i/$count: press Enter to capture... " _; then
      echo >&2
      echo "Input ended after $((i - 1)) of $count shots; stopping." >&2
      exit 1
    fi
    file=$(next_file "$base-$i")
  else
    file=$(next_file "$base")
  fi
  countdown
  shoot "$file"
  files+=("$file")
  if (( copy )); then copy_to_clipboard "$file"; fi
done

(( open_after )) && open "${files[@]}"
exit 0
