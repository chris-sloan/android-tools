#!/bin/bash
# Fake adb for the testing research (issue #4). Not a real test fixture.
# Put this folder first on PATH. It answers the handful of adb commands that
# adb-shot and adb-record use, with canned output, and logs every call.
#
#   FAKE_ADB_LOG      file that gets one line per call
#   FAKE_ADB_STATE    folder for the fake screenrecord's pid file
#   FAKE_ADB_DEVICES  body of 'adb devices' (printf %b), default one emulator
#   FAKE_ADB_API      ro.build.version.sdk, default 35
#   FAKE_ADB_SF       output of 'dumpsys SurfaceFlinger' (printf %b)
#   FAKE_ADB_WARN     set: screencap prints a warning line before the PNG
#   FAKE_ADB_NOPNG    set: screencap returns text, not a PNG
#   FAKE_ADB_REC_SECS how long the fake screenrecord runs if not stopped (2)
#   FAKE_ADB_PULL_FAIL set: 'adb pull' fails
echo "adb $*" >> "${FAKE_ADB_LOG:-/dev/null}"
state=${FAKE_ADB_STATE:-/tmp}

if [[ $1 == devices ]]; then
  echo "List of devices attached"
  printf '%b' "${FAKE_ADB_DEVICES-emulator-5554\tdevice\n}"
  echo
  exit 0
fi
if [[ $1 == -s ]]; then shift 2; fi

case "$*" in
  "shell getprop ro.product.model") printf 'Pixel 9 Pro\r\n' ;;
  "shell getprop ro.build.version.sdk") printf '%s\r\n' "${FAKE_ADB_API:-35}" ;;
  "shell settings get system show_touches") printf '0\r\n' ;;
  "shell settings put system show_touches "*) ;;
  "shell dumpsys SurfaceFlinger") printf '%b' "${FAKE_ADB_SF-}" ;;
  "shell dumpsys SurfaceFlinger --display-id")
    printf 'Display 4619827259835644672 (HWC display 0): port=129 pnpId=GGL displayName="EMU_display_0"\r\n' ;;
  "exec-out screencap "*)
    if [[ -n $FAKE_ADB_NOPNG ]]; then echo "error: closed"; exit 0; fi
    if [[ -n $FAKE_ADB_WARN ]]; then echo "[Warning] Multiple displays were found, but no display id was specified!"; fi
    printf '\x89PNG\r\n\x1a\nfake-image-data' ;;
  "shell screenrecord "*)
    echo $$ > "$state/rec.pid"
    sleep "${FAKE_ADB_REC_SECS:-2}" &
    child=$!
    trap 'kill "$child" 2>/dev/null; echo stopped-by-signal >> "$state/rec.events"; exit 0' INT TERM
    wait "$child"
    echo ended-by-itself >> "$state/rec.events" ;;
  "shell pkill -INT screenrecord")
    # TERM, not INT: adb-record starts screenrecord as a background job, and a
    # non-interactive bash starts background jobs with SIGINT ignored, which
    # the fake cannot trap. (First attempt used INT and the fake never stopped.)
    if [[ -f $state/rec.pid ]]; then kill -TERM "$(cat "$state/rec.pid")" 2>/dev/null; fi ;;
  "pull "*)
    if [[ -n $FAKE_ADB_PULL_FAIL ]]; then echo "adb: error: failed to stat remote object" >&2; exit 1; fi
    echo "fake mp4" > "$3"
    echo "$2: 1 file pulled" ;;
  "shell rm -f "*) ;;
  *) echo "fake adb: unhandled: $*" >&2; exit 97 ;;
esac
exit 0
